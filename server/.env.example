# Copy this file to .env and fill it in.

PORT=4021

# Wallet address that receives USDC (Base network). REQUIRED.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Network (CAIP-2 id):
#   eip155:84532 = Base Sepolia (test money; default)
#   eip155:8453  = Base mainnet (real USDC; needs CDP keys below)
NETWORK=eip155:84532

# Facilitator that verifies and settles payments.
# Default is the free public testnet facilitator. For mainnet, set the CDP keys instead.
FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Naira per US dollar, used to price orders in USDC.
NGN_PER_USD=1500

# x402 pay-per-call price for catalogue requests, in USD. Set to 0 to make browsing free.
CATALOG_PRICE_USD=0.001

# Comma-separated list of sites allowed to call the API from a browser (* = any).
ALLOWED_ORIGINS=https://justicesol.github.io,http://localhost:5500,null

# Secret for the merchant order list (GET /api/admin/orders). Use a long random string.
ADMIN_TOKEN=
